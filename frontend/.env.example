# SolNeutral V6.1 / backend on Vercel, no separate Railway service required
# Vercel Root Directory: frontend
# Set environment variables in Vercel Project > Settings > Environment Variables.
# Values containing private API keys must not be committed.

# Browser-accessible DEVNET RPC. Use a public or domain-restricted devnet endpoint.
NEXT_PUBLIC_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_ENABLE_DEVNET_TRADING=true

# Optional PRIVATE mainnet RPC, used only by read-only server endpoints.
# SOLANA_RPC_URL=https://your-mainnet-rpc-provider.example/path-or-query-with-private-key

# Optional model narration: deterministic AI analysis works without these.
# ANTHROPIC_API_KEY=place-in-vercel-settings-only
# ANTHROPIC_MODEL=your-current-supported-model
# AI_DEMO_ACCESS_TOKEN=long-secret-used-by-private-AI-preview

# Do not paste legacy Railway variables, wallet keypairs, or Solana seed phrases.
# No env setting makes the experimental SolNeutral vault ready for mainnet money.
