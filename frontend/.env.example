# SolNeutral V7.6 · Root Directory: frontend
# Public wallet RPC — must return the actual SOLANA TESTNET genesis hash.
NEXT_PUBLIC_TESTNET_RPC_URL=https://api.testnet.solana.com

# Private SolNeutral AI (configure in Vercel, never expose a real key)
# ANTHROPIC_API_KEY=...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Configure Vercel WAF rate limits for /api/ai/interpret.

# Coinbase public SOL/USD candle API needs no token.
# No Drift tokens, USDC faucet, smart-contract program ID or vault contract required
# for the wallet-owned SOL reserve. No yield or Drift transactions are executed.
# Legacy NEXT_PUBLIC_DEVNET_RPC_URL and NEXT_PUBLIC_ENABLE_DEVNET_TRADING are ignored.
